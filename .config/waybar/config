{
"layer": "bot",
"spacing": 0,
"height": 0,
"margin-top": 0,
"position": "top",
"margin-right": 50,
"margin-bottom": 0,
"margin-left": 50,

"modules-left": [
	"custom/os_icon",
	"hyprland/workspaces",
	"wlr/taskbar"
],

"modules-center": [
	"clock"
],

"modules-right": [
	"tray",
	"network",
	"battery",
	"pulseaudio"
],

"custom/os_icon": {
	"format": "",
	"on-click": "fuzzel || pkill fuzzel",
	"on-click-right": "pkill fuzzel",
	"tooltip": false
},

"hyprland/workspaces": {
     "format": "{icon}",
     "move-to-monitor": true,
     "on-scroll-up": "hyprctl dispatch workspace e+1",
     "on-scroll-down": "hyprctl dispatch workspace e-1"
},

"wlr/taskbar": {
	"format": "{icon}",
	"spacing": 3,
	"icon-size": 23,
	"on-click": "activate",
	"tooltip-format": "{title}"
},

"tray": {
	"spacing": 10,
	"tooltip": false
},

"clock": {
	"format": "{:%H:%M - %a | %d %b %Y}",
	"tooltip": false
},

"network": {
	"format-wifi" : "󰤢 {bandwidthDownBits}",
	"format-ethernet": "󰤢 {bandwidthDownBits}",
	"format-disconnected" : "󰤠 No Network",
	"interval": 5,
	"tooltip": false
},

"pulseaudio": {
	"scroll-step": 5,
	"max-volume": 150,
	"format": "{icon} {volume}%",
	"format-bluetooth": "{icon} {volume}%",
	"format-icons": ["", "", " "],
	"nospacing": 1,
	"format-muted": " ",
	"on-click": "pavucontrol",
	"tooltip": true
},

"battery": {
	"format": "{icon} {capacity}%",
	"interval": 5,
	"states": {
	"warning": 20,
	"critical": 10
},

"format-icons": ["", "", "", "", ""],
	"tooltip": false
}
}
